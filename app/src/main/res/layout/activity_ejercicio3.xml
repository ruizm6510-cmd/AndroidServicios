<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Ejercicio3Activity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 3: PUT vs PATCH"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1D1D1F"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PUT reemplaza el recurso completo. PATCH modifica únicamente los campos especificados (Endpoint: /posts/1)."
        android:textSize="14sp"
        android:textColor="#6E6E73"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nuevo Título (title)"
        android:layout_marginBottom="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título Actualizado" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nuevo Cuerpo (body)"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contenido completo del post para PUT" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Actualizar (PUT)"
            android:textSize="13sp"
            android:padding="12dp"
            app:cornerRadius="8dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPatch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Modificar (PATCH)"
            android:textSize="13sp"
            android:padding="12dp"
            app:cornerRadius="8dp"
            android:layout_marginStart="6dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvResultadoPutPatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccione PUT o PATCH para enviar la petición..."
            android:textSize="14sp"
            android:textColor="#2C3E50"
            android:fontFamily="monospace" />
    </ScrollView>

</LinearLayout>
