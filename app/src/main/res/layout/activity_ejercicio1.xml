<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".Ejercicio1Activity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 1: GET Lista de Usuarios"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1D1D1F"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Consulta GET a https://jsonplaceholder.typicode.com/users usando StringRequest de Volley."
        android:textSize="14sp"
        android:textColor="#6E6E73"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCargarUsuarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Obtener y Parsear Usuarios"
        android:textSize="14sp"
        android:padding="12dp"
        app:cornerRadius="8dp"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvResultadoNombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Presione el botón para cargar..."
                android:textSize="15sp"
                android:textColor="#2C3E50"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Respuesta JSON Cruda:"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#7F8C8D"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvResultadoJson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esperando respuesta..."
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="#555555" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
